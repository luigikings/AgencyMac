# Dependencies
node_modules/

# Builds
dist/
.astro/

# Test and audit reports
test-results/
playwright-report/
.lighthouseci/

# Environment variables and secrets (only .env.example may be committed)
.env
.env.*
!.env.example
.dev.vars

# Wrangler local state (may hold account data) and the staging copy of the web
.wrangler/
apps/web/.staging/

# Original illustrations and logos (large, opaque backgrounds, never versioned).
# Only the derivatives listed in scripts/assets/manifest.mjs are committed.
/Assets/

# Local-only settings and private notes
.claude/settings.local.json
MEMORY.local.md

# Lockfiles of other package managers (this repo uses pnpm only)
package-lock.json
yarn.lock
