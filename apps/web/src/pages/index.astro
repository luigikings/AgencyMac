---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeContent from "../components/HomeContent.astro";
import { buildHomeSeo } from "../lib/home-seo";
import { localizePath, t, type Locale } from "../lib/i18n";

const locale: Locale = "es";
const { social, jsonLd } = buildHomeSeo(Astro.site!, locale);
---

<BaseLayout
  locale={locale}
  title={t(locale, "home.title")}
  description={t(locale, "home.description")}
  seo={{ path: localizePath(locale, "/") }}
  social={social}
  jsonLd={jsonLd}
  fullWidth
  sky
>
  <HomeContent locale={locale} />
</BaseLayout>
