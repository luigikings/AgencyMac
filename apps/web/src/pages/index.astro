---
import { SITE_NAME, buildPageTitle } from "../lib/site";

// Provisional minimal page (spec 001). Spec 002 replaces it with the
// bilingual skeleton, brand tokens and full SEO.
const title = buildPageTitle(
  SITE_NAME,
  "Agencia de marketing, análisis y coding",
);
const description =
  "AgencyMac es una agencia de marketing, análisis y coding: diseño web, SEO con mantenimiento y campañas de Google Ads para hacer despegar tu negocio.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      /* Temporary colours with AA contrast; brand tokens arrive in spec 002. */
      :root {
        color-scheme: dark;
        --bg: #0b1020;
        --text: #f5f7ff;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, sans-serif;
      }

      h1 {
        margin: 0;
        padding: 0 16px;
        font-size: clamp(2.5rem, 12vw, 6rem);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{SITE_NAME}</h1>
    </main>
  </body>
</html>
