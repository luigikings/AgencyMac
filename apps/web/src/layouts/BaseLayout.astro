---
import { Font } from "astro:assets";
import SiteFooter from "../components/SiteFooter.astro";
import SkyBackdrop from "../components/SkyBackdrop.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { Locale } from "../lib/i18n";
import { SITE_NAME, buildPageTitle } from "../lib/site";
import { alternateLinks, canonicalUrl, type SocialMetaTag } from "../lib/seo";
import { ambientsCss } from "../lib/sky/ambient-css";
import { skyStarsCss } from "../lib/sky/sky-css";
import { colors, fontPreloads, fonts, tokensToCss } from "../styles/tokens";

interface Props {
  locale: Locale;
  /** Page title, already translated (the site name is appended here). */
  title: string;
  /** Meta description, already translated. */
  description: string;
  /** Indexable page: its path; `null` for pages without canonical/hreflang (404). */
  seo: { path: string } | null;
  /** Show the link to the other language in the header (false on the 404s). */
  showLanguageSwitch?: boolean;
  /**
   * Full-width main (home page): no max-width and no padding, so each
   * section draws its own band edge to edge. False keeps the one-column
   * main of the 404s.
   */
  fullWidth?: boolean;
  /** Fixed sky of stars behind the content (home pages only; spec 005). */
  sky?: boolean;
  /** Open Graph and Twitter tags (home pages only). */
  social?: SocialMetaTag[];
  /** Serialized JSON-LD for a `application/ld+json` block (home pages only). */
  jsonLd?: string;
}

const {
  locale,
  title,
  description,
  seo,
  showLanguageSwitch = true,
  fullWidth = false,
  sky = false,
  social = [],
  jsonLd,
} = Astro.props;

if (!Astro.site) {
  throw new Error("`site` must be set in astro.config.mjs");
}
const site = Astro.site;
const canonical = seo ? canonicalUrl(site, seo.path) : null;
const alternates = seo ? alternateLinks(site, seo.path) : [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{buildPageTitle(SITE_NAME, title)}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    {social.map(({ attr, key, content }) =>
      attr === "property" ? (
        <meta property={key} content={content} />
      ) : (
        <meta name={key} content={content} />
      ),
    )}
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={jsonLd} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {/* RF-18/RF-19: self-hosted @font-face (swap) + metric-adjusted fallbacks. */}
    <Font
      cssVariable={fonts.heading.cssVariable}
      preload={fontPreloads(fonts.heading)}
    />
    <Font
      cssVariable={fonts.body.cssVariable}
      preload={fontPreloads(fonts.body)}
    />
    <style is:inline set:html={tokensToCss(colors)} />
    {sky && <style is:inline id="sky-stars" set:html={skyStarsCss()} />}
    {sky && <style is:inline id="sky-ambients" set:html={ambientsCss()} />}
  </head>
  <body data-sky={sky ? "" : undefined}>
    {sky && <SkyBackdrop />}
    <SiteHeader locale={locale} showLanguageSwitch={showLanguageSwitch} />
    <main id="content" class:list={{ "main--full": fullWidth }}>
      <slot />
    </main>
    <SiteFooter locale={locale} horizon={sky} />
  </body>
</html>

<style is:global>
  /* Colours come only from the brand tokens (src/styles/tokens.ts). */
  :root {
    color-scheme: dark;
  }

  /* Column layout: main grows so the footer sits at the bottom of the
     window on short pages (100vh is the fallback for browsers without dvh). */
  body {
    display: flex;
    flex-direction: column;
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: 1.5;
  }

  main {
    flex: 1 0 auto;
    box-sizing: border-box;
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  main.main--full {
    max-width: none;
    padding: 0;
  }

  h1,
  h2 {
    /* Lilita One has a single weight (400): avoid a synthetic bold. */
    font-family: var(--font-heading);
    font-weight: 400;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  h1 {
    font-size: clamp(2rem, 8vw, 4rem);
  }

  a {
    color: var(--color-accent-green);
  }

  /* RF-21: visible keyboard focus, AA non-text contrast on the purple backgrounds. */
  :focus-visible {
    outline: 3px solid var(--color-button-hover);
    outline-offset: 2px;
  }

  /* RF-33: with reduced motion nothing moves in CSS and the scroll is the
     browser's own. Motion in CSS is only ever added under no-preference. */
  @media (prefers-reduced-motion: reduce) {
    *,
    ::before,
    ::after {
      transition: none !important;
      animation: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
