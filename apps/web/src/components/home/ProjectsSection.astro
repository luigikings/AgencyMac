---
import earth from "../../assets/brand/planet-earth.webp";
import { t, type Locale } from "../../lib/i18n";
import { PROJECTS } from "../../lib/site-data";
import BrandPicture from "../BrandPicture.astro";

// RF-6, RF-7: two real projects with an external link each. No screenshots:
// the only image is the decorative Earth next to the heading.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="projects" class="projects" aria-labelledby="projects-heading">
  <div class="projects__inner">
    <div class="projects__intro">
      <h2 id="projects-heading" data-sky-text>
        {t(locale, "projects.heading")}
      </h2>
      <p data-sky-text>{t(locale, "projects.intro")}</p>
      <BrandPicture
        src={earth}
        alt=""
        widths={[160, 240, 320]}
        sizes="10rem"
        class="projects__earth"
      />
    </div>
    <div class="projects__list">
      {PROJECTS.map((project) => (
        <article class="project">
          <span class="project__border" aria-hidden="true" />
          <div class="project__panel">
            <h3>{project.name}</h3>
            <p>{t(locale, project.descriptionKey)}</p>
            <a href={project.url} target="_blank" rel="noopener">
              {t(locale, "projects.visit")} {project.domain}
              <span class="project__notice">
                {t(locale, "projects.newTab")}
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Colours come only from the brand tokens (src/styles/tokens.ts). */
  .projects {
    /* The decorative Earth may poke out of the box: clip it here. */
    overflow: clip;
    background: var(--color-bg);
  }

  .projects__inner {
    box-sizing: border-box;
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .projects__intro {
    position: relative;
    margin-bottom: 2rem;
    padding-right: 7rem;
  }

  .projects__intro h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 6vw, 2.75rem);
  }

  .projects__intro p {
    margin: 0;
    font-size: 1.125rem;
  }

  .projects__intro :global(.projects__earth) {
    position: absolute;
    top: 0;
    right: 0;
    width: 5rem;
    height: auto;
  }

  .projects__list {
    display: grid;
    gap: 1.5rem;
  }

  /* RF-33 (spec 005, plan D10): a cosmic border. The card is a ring of 2 px
     where a conic gradient of brand colours shows around a solid panel; the
     text sits on the panel, so its contrast can be computed. The gradient is
     drawn by an empty decorative element (and its ::before), not by a
     pseudo-element of the card: axe cannot tell the background of text
     whose ancestor has one, and leaves its contrast as "needs review". It
     is a square layer twice as wide as the card, centred, so it covers every
     corner whatever its turn; it only turns (with transform, on the
     compositor) while the card has the cursor or the focus, and only with
     animation. Without it, the border is there and still. */
  .project {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 2px;
    border-radius: 1rem;
    background: var(--color-accent-green);
  }

  .project__border {
    position: absolute;
    z-index: 0;
    inset: 0;
    /* The turning layer is wider than the card: clipped here (clip, not
       hidden: no scroll container is made). */
    overflow: clip;
    border-radius: inherit;
    pointer-events: none;
  }

  /* The turning gradient: inside the border element, so no box of the card
     reaches past the card itself (axe looks at those boxes). */
  .project__border::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: conic-gradient(
      var(--color-accent-green),
      var(--color-button-hover),
      var(--color-logo-gradient-1),
      var(--color-logo-gradient-3),
      var(--color-accent-green)
    );
  }

  /* Positioned above the border, so the stack is plain for axe too. */
  .project__panel {
    position: relative;
    z-index: 1;
    height: 100%;
    box-sizing: border-box;
    padding: 1.5rem;
    border-radius: calc(1rem - 2px);
    background: var(--color-bg-dark);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project:is(:hover, :focus-within) .project__border::before {
      animation: project-border-spin 4s linear infinite;
    }

    @keyframes project-border-spin {
      to {
        transform: translate(-50%, -50%) rotate(1turn);
      }
    }
  }

  .project h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .project p {
    margin: 0 0 1rem;
    font-size: 1.125rem;
  }

  .project a {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .project__notice {
    margin-left: 0.4rem;
    font-weight: 400;
  }

  @media (min-width: 48rem) {
    .projects__intro {
      /* Tall enough for the Earth, so it never touches the cards. */
      min-height: 8rem;
      padding-right: 11rem;
    }

    .projects__intro :global(.projects__earth) {
      width: 8rem;
    }

    .projects__list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
