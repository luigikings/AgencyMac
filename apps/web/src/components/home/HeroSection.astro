---
import mac from "../../assets/brand/mac.webp";
import moon from "../../assets/brand/moon.webp";
import { t, type Locale } from "../../lib/i18n";
import { DISCOVER_TARGET } from "../../lib/site-data";
import BrandPicture from "../BrandPicture.astro";

// First section (RF-2, RF-3). Everything is plain HTML on a solid background:
// the only decoration is the halo behind the images, never under text.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__text">
      <p class="hero__kicker" data-sky-text>
        {t(locale, "hero.kicker")}
      </p>
      <h1 id="hero-heading" data-sky-text>
        {t(locale, "hero.heading")}
      </h1>
      <p class="hero__tagline" data-sky-text>
        {t(locale, "hero.tagline")}
      </p>
      <p class="hero__subtitle" data-sky-text>
        {t(locale, "hero.subtitle")}
      </p>
      <a class="hero__discover" href={DISCOVER_TARGET}>
        {t(locale, "hero.discover")}
      </a>
    </div>
    <div class="hero__art" data-mac-label={t(locale, "hero.macGestureLabel")}>
      <div class="hero__halo" aria-hidden="true"></div>
      <div class="hero__aura" aria-hidden="true"></div>
      <BrandPicture
        src={moon}
        alt=""
        widths={[360, 540, 733]}
        sizes="(min-width: 48rem) 28rem, 90vw"
        priority
        highPriority
        class="hero__moon"
      />
      <div class="hero__orbit" aria-hidden="true">
        <span class="hero__orbit-body"></span>
      </div>
      <div class="hero__sparkles" aria-hidden="true">
        <span class="hero__sparkle"></span>
        <span class="hero__sparkle"></span>
        <span class="hero__sparkle"></span>
        <span class="hero__sparkle"></span>
      </div>
      {/* Two layers (plan D17): the wrapper carries the CSS entrance, the image
          stays free for the gesture and the gaze of the animation layer. */}
      <div class="hero__mac-wrap">
        <div class="hero__flame" aria-hidden="true"></div>
        <BrandPicture
          src={mac}
          alt={t(locale, "hero.macAlt")}
          widths={[240, 360, 540]}
          sizes="(min-width: 48rem) 20rem, 64vw"
          priority
          highPriority
          class="hero__mac"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Colours come only from the brand tokens (src/styles/tokens.ts). */
  .hero {
    background: var(--color-bg);
  }

  .hero__inner {
    box-sizing: border-box;
    display: grid;
    gap: 2rem;
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }

  .hero__kicker {
    margin: 0 0 0.5rem;
    color: var(--color-button-hover);
    font-family: var(--font-heading);
    font-size: 1.125rem;
  }

  .hero h1 {
    margin: 0 0 0.75rem;
  }

  .hero__tagline {
    margin: 0 0 1rem;
    color: var(--color-accent-green);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    line-height: 1.2;
  }

  .hero__subtitle {
    margin: 0 0 1.5rem;
    font-size: 1.125rem;
  }

  .hero__discover {
    display: inline-block;
    box-sizing: border-box;
    padding: 0.55rem 1.25rem;
    border: 2px solid var(--color-button-hover);
    border-radius: 999px;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    text-decoration: none;
  }

  .hero__discover:hover {
    background: var(--color-bg-dark);
  }

  /* The art keeps a fixed square so nothing moves when the images arrive. */
  .hero__art {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 28rem;
    aspect-ratio: 1 / 1;
  }

  .hero__halo {
    position: absolute;
    /* Fades out before the edge of the art box: it never spills over. */
    inset: 0;
    background: radial-gradient(
      circle closest-side,
      color-mix(in srgb, var(--color-button-hover) 22%, transparent) 0%,
      transparent 100%
    );
  }

  .hero__art :global(.hero__moon) {
    position: absolute;
    height: auto;
    top: 0;
    right: 0;
    width: 78%;
  }

  .hero__mac-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 68%;
  }

  .hero__art :global(.hero__mac) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Decoration (spec 005, RF-19): none of it covers text, takes focus or
     moves the layout; it is all absolute inside the art. Still and complete
     without animation. */
  /* The aura is the shadow of a circle the size of the moon, behind it: a
     shadow adds nothing to the scrollable area, so it cannot overflow. */
  .hero__aura {
    position: absolute;
    top: 0;
    right: 0;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    box-shadow:
      0 0 2.5rem 0.5rem
        color-mix(in srgb, var(--color-logo-gradient-1) 38%, transparent),
      0 0 6rem 1.5rem
        color-mix(in srgb, var(--color-logo-gradient-2) 22%, transparent);
  }

  .hero__orbit {
    position: absolute;
    /* The body rides a circle just inside the ring: it never leaves this box. */
    inset: 1%;
    border: 1px dashed
      color-mix(in srgb, var(--color-accent-green) 35%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }

  /* The body rides a circle (offset-path): the square of the orbit never
     turns, so nothing sticks out of the art. Without support for offset-path
     it simply stays at the start of the ring. */
  .hero__orbit-body {
    position: absolute;
    top: 0;
    left: 0;
    width: 6.4%;
    offset-path: circle(46.8% at 50% 50%);
    offset-rotate: 0deg;
    offset-distance: 0%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 35%,
      var(--color-text),
      var(--color-accent-green) 55%,
      var(--color-button-hover)
    );
  }

  .hero__sparkles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__sparkle {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--color-button-hover);
    clip-path: polygon(
      50% 0,
      62% 38%,
      100% 50%,
      62% 62%,
      50% 100%,
      38% 62%,
      0 50%,
      38% 38%
    );
    opacity: 0.8;
  }

  .hero__sparkle:nth-child(1) {
    left: 4%;
    top: 34%;
  }

  .hero__sparkle:nth-child(2) {
    left: 46%;
    top: 4%;
  }

  .hero__sparkle:nth-child(3) {
    left: 90%;
    top: 52%;
  }

  .hero__sparkle:nth-child(4) {
    left: 58%;
    top: 90%;
  }

  /* The thruster under the saucer. Off by default (scaled to nothing, no
     rule hides it); it only burns during the entrance flight, below. */
  .hero__flame {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 74%;
    height: 38%;
    background: radial-gradient(
      ellipse at 50% 0,
      color-mix(in srgb, var(--color-button-hover) 95%, transparent) 0%,
      color-mix(in srgb, var(--color-logo-gradient-2) 80%, transparent) 40%,
      transparent 75%
    );
    transform: scale(0);
    transform-origin: 50% 0;
    pointer-events: none;
  }

  /* Entrance of the hero (spec 005, RF-16 to RF-18): plain CSS, from the first
     paint, no script. Everything starts inside the window and fully opaque:
     it only moves and scales. Only the flame (a decoration) fades. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__kicker {
      animation: hero-text-in 0.35s ease-out both;
    }

    .hero h1 {
      animation: hero-text-in 0.35s ease-out 0.03s both;
    }

    .hero__tagline {
      animation: hero-text-in 0.35s ease-out 0.06s both;
    }

    .hero__subtitle {
      animation: hero-text-in 0.35s ease-out 0.09s both;
    }

    .hero__discover {
      animation: hero-text-in 0.35s ease-out 0.12s both;
    }

    .hero__art :global(.hero__moon) {
      animation: hero-moon-rise 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    /* Flight 0.2 to 1.2 s, then a 0.4 s bounce on the moon (ends at 1.6 s). */
    .hero__mac-wrap {
      animation:
        hero-mac-land 1s cubic-bezier(0.3, 0.7, 0.3, 1) 0.2s both,
        hero-mac-bounce 0.4s ease-out 1.2s forwards;
    }

    .hero__flame {
      animation: hero-flame 1.05s ease-out 0.2s both;
    }

    /* Always-on decoration: compositor only (transform, opacity), one cycle
       per blink, never faster than 3 blinks a second (RNF-10). */
    .hero__aura {
      animation: hero-aura 5s ease-in-out infinite alternate;
    }

    .hero__orbit {
      animation: orbit-ring 1.2s ease-out both;
    }

    .hero__orbit-body {
      animation: hero-orbit-spin 22s linear infinite;
    }

    .hero__sparkle:nth-child(1) {
      animation: hero-sparkle 2.2s ease-in-out infinite;
    }

    .hero__sparkle:nth-child(2) {
      animation: hero-sparkle 2.9s ease-in-out 0.6s infinite;
    }

    .hero__sparkle:nth-child(3) {
      animation: hero-sparkle 3.4s ease-in-out 1.1s infinite;
    }

    .hero__sparkle:nth-child(4) {
      animation: hero-sparkle 2.6s ease-in-out 1.7s infinite;
    }

    @keyframes hero-aura {
      from {
        opacity: 0.55;
      }

      to {
        opacity: 1;
      }
    }

    @keyframes orbit-ring {
      from {
        opacity: 0.1;
      }

      to {
        opacity: 1;
      }
    }

    @keyframes hero-orbit-spin {
      to {
        offset-distance: 100%;
      }
    }

    @keyframes hero-sparkle {
      0%,
      100% {
        opacity: 0.15;
        transform: scale(0.6);
      }

      50% {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes hero-text-in {
      from {
        transform: translateY(14px);
      }

      to {
        transform: none;
      }
    }

    @keyframes hero-moon-rise {
      from {
        transform: translateY(14%) scale(0.88);
      }

      to {
        transform: none;
      }
    }

    @keyframes hero-mac-land {
      0% {
        transform: translate(-4%, 24%) scale(0.7) rotate(-12deg);
      }

      60% {
        transform: translate(2%, -4%) scale(1.04) rotate(3deg);
      }

      100% {
        transform: none;
      }
    }

    @keyframes hero-mac-bounce {
      0% {
        transform: none;
      }

      35% {
        transform: translateY(-5%) scale(1.02, 0.98);
      }

      70% {
        transform: translateY(1.5%) scale(0.99, 1.01);
      }

      100% {
        transform: none;
      }
    }

    @keyframes hero-flame {
      0% {
        opacity: 0;
        transform: scaleY(0.3);
      }

      12% {
        opacity: 0.95;
        transform: scaleY(1);
      }

      80% {
        opacity: 0.95;
        transform: scaleY(1.15);
      }

      100% {
        opacity: 0;
        transform: scaleY(0.3);
      }
    }
  }

  /* Mac is only focusable while the animation layer makes it a button. */
  .hero__art :global(.hero__mac:focus-visible) {
    outline: 3px solid var(--color-button-hover);
    outline-offset: 4px;
  }

  @media (min-width: 48rem) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      padding-top: 3rem;
      padding-bottom: 4rem;
    }
  }
</style>
