---
import { t, type Locale } from "../../lib/i18n";
import { TEAM } from "../../lib/site-data";

// RF-8: three people, only first name and role. No photos, avatars or
// surnames.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="team" class="team" aria-labelledby="team-heading">
  <div class="team__inner">
    <h2 id="team-heading">{t(locale, "team.heading")}</h2>
    <p class="team__intro">{t(locale, "team.intro")}</p>
    <ul class="team__list">
      {TEAM.map((person) => (
        <li class="member">
          <h3>{person.name}</h3>
          <p>{t(locale, person.roleKey)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Colours come only from the brand tokens (src/styles/tokens.ts). */
  .team {
    background: var(--color-bg-dark);
  }

  .team__inner {
    box-sizing: border-box;
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .team__inner h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 6vw, 2.75rem);
  }

  .team__intro {
    margin: 0 0 2rem;
    max-width: 40rem;
    font-size: 1.125rem;
  }

  .team__list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .member {
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-button);
    background: var(--color-bg);
  }

  .member h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .member p {
    margin: 0.25rem 0 0;
    color: var(--color-button-hover);
    font-size: 1.125rem;
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .team__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
