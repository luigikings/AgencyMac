---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

// The only wrapper around <Picture> (RF-24, RF-25): AVIF and WebP in several
// widths, the intrinsic size of the source declared, async decoding and lazy
// loading unless the image is above the fold (`priority`: eager; the image
// that can be the LCP also gets `fetchpriority="high"`).
interface Props {
  src: ImageMetadata;
  /** Real alt text; empty only for purely decorative images. */
  alt: string;
  /** Widths (px) to generate, from small to large. */
  widths: number[];
  /** `sizes` attribute: the width the image is shown at. */
  sizes: string;
  /** Visible on load: loaded eagerly. */
  priority?: boolean;
  /** High fetch priority, for the LCP candidate. */
  highPriority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  widths,
  sizes,
  priority = false,
  highPriority = false,
  class: className,
} = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  formats={["avif", "webp"]}
  widths={widths}
  sizes={sizes}
  loading={priority ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={highPriority ? "high" : undefined}
  class={className}
/>
