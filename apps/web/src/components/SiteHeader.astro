---
import logo from "../assets/brand/logo-white-letters.png";
import { localizePath, otherLocale, t, type Locale } from "../lib/i18n";
import { NAV_SECTIONS } from "../lib/site-data";
import BrandPicture from "./BrandPicture.astro";
import CtaButton from "./CtaButton.astro";

interface Props {
  locale: Locale;
  /**
   * Full header of the home page: section links, language link and the call
   * to action. False on the 404s: only the logo (no nav landmark at all).
   */
  showLanguageSwitch: boolean;
}

const { locale, showLanguageSwitch } = Astro.props;
const target = otherLocale(locale);
---

<header class="site-header">
  <a class="skip-link" href="#content">
    {t(locale, "a11y.skipToContent")}
  </a>
  <div class="site-header__inner">
    <a class="site-header__brand" href={localizePath(locale, "/")}>
      <BrandPicture
        src={logo}
        alt={t(locale, "nav.home")}
        widths={[144, 288, 432]}
        sizes="144px"
        priority
        class="site-header__logo"
      />
    </a>
    {
      /* Without the language switch (404s) no navigation landmark is
         rendered: the logo link and the page's own link lead home. */
      showLanguageSwitch && (
        <>
          <nav class="site-header__nav" aria-label={t(locale, "nav.label")}>
            <ul class="site-header__links">
              {NAV_SECTIONS.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{t(locale, section.navKey)}</a>
                </li>
              ))}
              <li>
                <a
                  href={localizePath(target, "/")}
                  hreflang={target}
                  lang={target}
                >
                  {t(locale, "nav.switchLanguage")}
                </a>
              </li>
            </ul>
          </nav>
          <CtaButton locale={locale} />
        </>
      )
    }
  </div>
</header>

<style>
  /* Colours come only from the brand tokens (src/styles/tokens.ts). */
  .site-header {
    background: var(--color-bg-dark);
  }

  .site-header__inner {
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: 60rem;
    margin: 0 auto;
    padding: 1rem;
  }

  .site-header__brand {
    display: block;
    flex: none;
    width: 9rem;
    line-height: 0;
  }

  .site-header__brand :global(.site-header__logo) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The nav takes the free space between the logo and the button; on narrow
     screens it drops to its own row. */
  .site-header__nav {
    flex: 1 1 auto;
    order: 3;
    width: 100%;
  }

  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__links a {
    display: inline-block;
    padding: 0.25rem 0;
  }

  @media (min-width: 62rem) {
    .site-header__nav {
      order: 0;
      width: auto;
    }

    .site-header__links {
      justify-content: center;
    }
  }

  /* Hidden until it receives keyboard focus. */
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 1;
    padding: 0.5rem 1rem;
    background: var(--color-bg-dark);
    color: var(--color-text);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
