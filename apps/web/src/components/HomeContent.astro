---
import type { Locale } from "../lib/i18n";
import { macLinesJson } from "../lib/mac-lines";
import ContactSection from "./home/ContactSection.astro";
import HeroSection from "./home/HeroSection.astro";
import ProjectsSection from "./home/ProjectsSection.astro";
import ServicesSection from "./home/ServicesSection.astro";
import TeamSection from "./home/TeamSection.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<HeroSection locale={locale} />
<ServicesSection locale={locale} />
<ProjectsSection locale={locale} />
<TeamSection locale={locale} />
<ContactSection locale={locale} />

<!-- Mac's lines (spec 005): data, not code; read by the effects layer when needed. -->
<script
  type="application/json"
  id="mac-lines"
  is:inline
  set:html={macLinesJson(locale)}
/>
<!-- Deferred animation layer (spec 004): the content above needs none of it. -->
<script>
  import "../scripts/motion-entry";
</script>
